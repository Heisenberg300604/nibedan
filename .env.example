TELEGRAM_BOT_TOKEN="your-token"
TELEGRAM_CHAT_ID="your-chat-id"
GEMINI_API_KEY="your-api-key"
NODE_ENV="development"
NEXT_PUBLIC_UMAMI_SRC="your-umami-script-url"
NEXT_PUBLIC_UMAMI_ID="your-umami-website-id"
# Production origin, no trailing slash. Canonical tags, sitemap and JSON-LD
# are all derived from this. Leaving it as localhost keeps the site noindex.
NEXT_PUBLIC_URL="https://your-domain.com"
